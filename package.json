    "author": "LifetimeSoft",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lifetimesoft/lifectl.git"
    },
    "homepage": "https://github.com/lifetimesoft/lifectl#readme",
    "type": "module",
    "dependencies": {
        "@types/archiver": "^7.0.0",
        "archiver": "^7.0.1",
        "axios": "^1.13.6",
        "commander": "^14.0.3",
        "fs-extra": "^11.3.4",
        "open": "^11.0.0"
    },
    "devDependencies": {
        "@types/fs-extra": "^11.0.4",
        "typescript": "^5.0.0"
    }
}
