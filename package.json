{
    "name": "@lifetimesoft/lifectl",
    "version": "0.0.1",
    "description": "CLI tool for pulling, running, and managing AI agents",
    "bin": {
        "lifectl": "dist/index.js"
    },
    "publishConfig": {
        "access": "public"
    },
    "main": "dist/index.js",
    "files": [
        "dist/"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "start": "node dist/index.js",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
